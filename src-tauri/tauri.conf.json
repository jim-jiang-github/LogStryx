{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LogStryx",
  "version": "0.1.0",
  "identifier": "com.jimjiang.logstryx",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "LogStryx · 智能日志检索",
        "width": 960,
        "height": 680,
        "minWidth": 720,
        "minHeight": 480,
        "decorations": false,
        "dragDropEnabled": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.ico"],
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
